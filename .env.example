# ---- Backend (copy to backend/.env) ----
# Optional LLM assessment. Leave empty to use the deterministic rule-based engine.
LLM_API_KEY=
LLM_MODEL=claude-haiku-4-5
LLM_TIMEOUT_SECONDS=8

# MongoDB (required). Start one locally with:  docker compose up -d mongo
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=crisis_command
MONGODB_TIMEOUT_MS=5000

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Tunables (defaults live in backend/config.py)
WAITING_COEFFICIENT=0.5
MAX_WAITING_BONUS=30
AVERAGE_SPEED_KMH=40
SOLVER_TIME_LIMIT_SECONDS=10

# ---- Frontend (copy to frontend/.env, optional) ----
# Only needed if the backend is not on localhost:8000 / not proxied by Vite.
VITE_API_URL=
VITE_WS_URL=
